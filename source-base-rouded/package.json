{
  "name": "react-base-rouded",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.17.0",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "scripts": {
    "predev": "node scripts/check-hooks.mjs",
    "dev": "vite",
    "build": "npm run generate:styles && tsc -b tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,scripts}/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts}/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"*.{ts,js,mjs,json}\"",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project unit",
    "prepare": "husky",
    "generate:font": "node scripts/generate-font.mjs",
    "generate:colors": "node scripts/generate-colors.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:images": "node scripts/generate-images.mjs",
    "generate:vci-icons": "node scripts/generate-vci-icons.mjs",
    "generate:styles": "npm run generate:font && npm run generate:colors",
    "check:imports": "node scripts/check-imports.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "check:eslint-config": "node scripts/check-eslint-config.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:unused-files": "knip --no-progress --include files,dependencies",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "npm run check:hooks && npm run typecheck && npm run lint && npm run check:eslint-config && npm run format:check && npm run check:imports && npm run check:cycles && npm run check:unused-files && npm test",
    "check:all": "npm run check && npm run build && npm run check:bundle",
    "report:unused-exports": "knip --no-progress"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "react": "^19.2.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-number-format": "^5.4.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint": "^10.9.1",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "knip": "^5.88.1",
    "lint-staged": "^17.4.1",
    "madge": "^8.0.0",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  }
}
