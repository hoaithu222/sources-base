# ─────────────────────────────────────────────────────────────────────────────
# Base project (Next.js) — biến môi trường
#
# Chép file này thành `.env.local` rồi điền giá trị của máy bạn. `.env.local`
# không được commit và ghi đè `.env` (file mặc định dùng chung của repo).
# Next tự nạp: .env → .env.development / .env.production → .env.local.
#
# Mọi biến đều được KIỂM lúc `npm run dev` / `npm run build` (schema ở
# `src/core/config/env.schema.ts`): giá trị sai định dạng là dừng ngay kèm tên
# biến sai. Để TRỐNG một biến = dùng giá trị mặc định ghi bên cạnh.
#
# ⛔ Mọi biến có tiền tố NEXT_PUBLIC_ đều NẰM TRONG BUNDLE gửi cho trình duyệt.
#    KHÔNG đặt secret (API key, chuỗi kết nối DB, private key) ở đó.
# ─────────────────────────────────────────────────────────────────────────────

# ── Biến CÔNG KHAI (vào bundle trình duyệt) ──────────────────────────────────

# Chế độ ứng dụng: demo | app (mặc định app)
#   demo — bản trưng bày giao diện: không cần backend, kiểm đăng nhập TẮT sẵn,
#          có phân hệ "Thư viện UI". Repo base đặt giá trị này trong `.env`.
#   app  — sản phẩm thật: kiểm đăng nhập BẬT sẵn; build production bị chặn nếu
#          thiếu NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_SITE_URL hoặc đặt
#          NEXT_PUBLIC_AUTH_ENABLED=false.
NEXT_PUBLIC_APP_MODE=

# Tên hiển thị của ứng dụng — cũng là tên site trong thẻ <title>, Open Graph, JSON-LD (mặc định "Base App")
NEXT_PUBLIC_APP_NAME=

# Gốc site THẬT, KHÔNG kèm đường dẫn và KHÔNG có "/" cuối. Nền của canonical, hreflang,
# sitemap.xml, robots.txt, ảnh Open Graph — sai là mất thứ hạng SEO.
# Ví dụ: https://example.com     Mặc định (chỉ để dev): http://localhost:3000
# Trên Vercel có thể bỏ trống: lấy host production từ VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Gốc API — URL http(s) đầy đủ hoặc đường same-origin bắt đầu bằng "/".
# Mặc định /api — `next.config.ts` rewrite đường này về API_PROXY_TARGET, nên cookie
# HttpOnly refresh-token đi same-origin (không bị trình duyệt coi là third-party).
# Ví dụ production: https://api.example.com/api
# BE có version thì ghi luôn ở đây (vd /api/v1) — hàm API không tự thêm tiền tố version.
NEXT_PUBLIC_API_BASE_URL=

# Thời gian chờ tối đa mỗi request, mili-giây, SỐ NGUYÊN DƯƠNG (mặc định 30000)
NEXT_PUBLIC_API_TIMEOUT=

# Bật toast lỗi tập trung cho query/mutation: true | false (mặc định true)
NEXT_PUBLIC_ENABLE_ERROR_TOAST=

# Ghi log request/response ra console: true | false (mặc định false)
NEXT_PUBLIC_ENABLE_API_LOGGING=

# Bật kiểm đăng nhập: true | false
# (mặc định: true ở chế độ app, false ở chế độ demo)
# ⛔ `false` nghĩa là MỌI route mở cho người chưa đăng nhập — chỉ hợp lúc dựng
#    giao diện khi chưa có backend.
NEXT_PUBLIC_AUTH_ENABLED=

# ── Biến CHỈ Ở SERVER — KHÔNG có tiền tố NEXT_PUBLIC_, không vào bundle ──────

# Đích proxy của đường /api/*. Mặc định http://localhost:5000
API_PROXY_TARGET=

# Tên cookie HttpOnly mà BE đặt khi đăng nhập (mặc định refresh_token). `proxy.ts` chỉ kiểm
# cookie này CÓ TỒN TẠI để chặn sớm vùng riêng tư — không giải mã, không tin nội dung.
AUTH_SESSION_COOKIE=

# Cho công cụ tìm kiếm lập chỉ mục: true | false.
# Mặc định tự suy: production (hoặc VERCEL_ENV=production) = true, còn lại = false → robots.txt
# chặn toàn bộ + thẻ noindex, để bản preview / staging không lọt vào Google.
SEO_ALLOW_INDEXING=

# Mã xác minh quyền sở hữu site (thẻ <meta>) — lấy ở Google Search Console / Bing Webmaster Tools
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
