{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
  "eslint.useFlatConfig": true,
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "search.exclude": {
    "**/.next*": true,
    "**/coverage": true,
    "package-lock.json": true,
    "src/assets/icons/index.tsx": true,
    "src/assets/image/index.ts": true,
    "src/shared/ui/icons/index.ts": true,
    "**/*.generated.ts": true,
    "**/generated-*.css": true
  },
  "files.watcherExclude": {
    "**/.next*/**": true,
    "**/coverage/**": true
  },
  "i18n-ally.enabledFrameworks": ["next-intl"],
  "i18n-ally.localesPaths": ["src/messages"],
  "i18n-ally.pathMatcher": "{locale}/{namespaces}.json",
  "i18n-ally.namespace": true,
  "i18n-ally.keystyle": "nested",
  "i18n-ally.sourceLanguage": "vi",
  "i18n-ally.displayLanguage": "vi"
}
