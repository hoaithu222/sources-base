{
  "name": "next-base",
  "private": true,
  "version": "0.1.0",
  "description": "Base Next.js 16 (App Router) — UI kit, đa ngôn ngữ (vi/en), SEO chuẩn, phiên đăng nhập, bộ cổng chất lượng.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.17.0",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^6.0.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-arborist": "^4.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "predev": "node scripts/check-hooks.mjs",
    "dev": "next dev",
    "build": "npm run generate:styles && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,tests,scripts,e2e}/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"*.{ts,js,mjs,json}\"",
    "format:check": "prettier --check \"{src,tests,scripts,e2e}/**/*.{ts,tsx,js,jsx,mjs,json,css}\" \"*.{ts,js,mjs,json}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:smoke": "vitest run --project smoke",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project unit",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "generate:font": "node scripts/generate-font.mjs",
    "generate:colors": "node scripts/generate-colors.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:images": "node scripts/generate-images.mjs",
    "generate:vci-icons": "node scripts/generate-vci-icons.mjs",
    "generate:styles": "npm run generate:font && npm run generate:colors",
    "check:imports": "node scripts/check-imports.mjs",
    "check:cycles": "dpdm --no-warning --no-tree --exit-code circular:1 --transform \"src/**/*.{ts,tsx}\"",
    "check:eslint-config": "node scripts/check-eslint-config.mjs",
    "check:hooks": "node scripts/check-hooks.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:unused-files": "knip --no-progress --include files,dependencies",
    "check:generated": "node scripts/check-generated.mjs",
    "check": "npm run check:hooks && npm run typecheck && npm run lint && npm run check:eslint-config && npm run format:check && npm run check:i18n && npm run check:imports && npm run check:cycles && npm run check:unused-files && npm test",
    "check:fast": "npm run typecheck && npm run lint && npm run check:eslint-config && npm run check:i18n && npm run check:imports && npm run check:cycles",
    "check:ci": "npm run typecheck && npm run lint && npm run check:eslint-config && npm run format:check && npm run check:i18n && npm run check:imports && npm run check:cycles && npm run check:unused-files && npm run check:generated && npm run test:coverage && npm run test:smoke && npm run build && npm run check:static-routes && npm run build:app && npm run test:e2e",
    "build:app": "node scripts/build-app.mjs",
    "verify:commit": "node scripts/verify-commit.mjs",
    "report:unused-exports": "knip --no-progress",
    "analyze": "next experimental-analyze",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "check:static-routes": "node scripts/check-static-routes.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
